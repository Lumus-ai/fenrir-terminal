#!/bin/bash
# Fenrir Terminal v1.3.1 — команда-идентификатор: кто я, что живо, сколько памяти.
# Использование: fenrir | fenrir status | fenrir ram | fenrir orchestra
#   fenrir probe | fenrir health | fenrir watchdog | fenrir up | fenrir down
#   fenrir doctor | fenrir limits | fenrir usage
#   fenrir agent --task "..." --workdir <папка> [--kind code|text]
#   fenrir agent --file tasks.jsonl
#   fenrir task add|done|list|run|validate [--tasks tasks.yaml]
#   fenrir scheduler --once [--dry-run] [--tasks tasks.yaml] [--task-id ID]
#   fenrir morning [--date YYYY-MM-DD] — утренний дайджест v1.4
#   fenrir backup [--dry-run] [--no-upload] [--keep N] — бэкап на Drive v1.4
#   fenrir funpay check [--inbox PATH] [--dry-run] [--enqueue] — FunPay v2.2:
#     чтение и классификация, черновики в файл; --enqueue — сразу в очередь
#   fenrir funpay status — сводка по магазину
#   fenrir funpay queue — очередь отправки (outbox.json)
#   fenrir funpay enqueue <draft-id> — черновик в очередь (фишинг/агрессия — нет)
#   fenrir funpay fulfill [--inbox PATH] [--order ID] [--dry-run] — выполнение
#     простых текстовых заказов через агента (Lix), сдача — в очередь
#   fenrir council --task "..." [--workdir DIR] [--file F] [--dry-run] — консилиум v3.1:
#     кодер/ревьюер/тестер параллельно (макс 3 вызова), синтез + отчёт
#   fenrir remote status|limits|tasks|digest|help|history|pending — пульт v3.2:
#     команды чтения; stop|start|restart — только после /confirm <id>
#   fenrir remote notify <готово|упало|алерт> <текст> [--dry-run]
#   fenrir remote allow <user_id> | config | listen [--timeout N]
#   fenrir content add "<тема>" [--platform tiktok|telegram|both] [--queue] — контент v2.3:
#     очередь тем + дедуп + стоп-лист; list | queue <id> | remove <id> |
#     dedup "<тема>" | slots [--date YYYY-MM-DD] | render <id> [--duration N]
#     [--dry-run] — рендер ролика (шаг 2, только локально). ПОСТИНГА НЕТ.
#   fenrir project add <name> <folder> [--description "..."] [--tasks FNR-001,FNR-002] |
#     list | show <name> | remove <name> — реестр проектов v3.3 шаг 1:
#     только регистрация, без сборок и пайплайнов (только локально).
#   fenrir update [--check] [--dry-run] — обновление из GitHub
#     (Lumus-ai/fenrir-terminal, ветка main, только fast-forward;
#     грязное дерево или защищённые файлы во входящих — отказ; снапшот
#     в backups/ до pull, проверка py_compile + все сьюты после).
#   fenrir selfpatch propose --file patch.json | list | show <id> |
#     test <id> [--target DIR] | review <id> |
#     apply <id> --approved [--target DIR] | rollback <id> [--target DIR] — саморазвитие v3.0 шаг 1:
#     песочница самопатчей + очередь + тесты + откат (только локально).
#     Живой код сам не меняется; apply — только с --approved (явное «да» Shadow).
#   fenrir router pick --role code|review|text [--refresh] — выбор живой модели Lix
#   fenrir router status [--probe] — health, токены за день, бюджет, алерт
#   fenrir router probe | fenrir router refresh — health-проба / живой прайс
#   fenrir router weekly [--date YYYY-MM-DD] — еженедельный отчёт по тратам
#     (reports/weekly-YYYY-Www.md); при warn/over бюджета pick — фолбэк
#     на самую дешёвую живую модель роли, маркер state/router-budget
# Роутер v2.1 шаг 1 — fenrir_router.py в оркестре (только Lix; мёртвая тройка
# 403 никогда не предлагается; qwen-flash жив и кандидат для text).
# Планировщик v1.4 — fenrir_scheduler.py (ядро: tasks.yaml + runner).
# Утренний дайджест v1.4 — fenrir_digest.py.
# Бэкап v1.4 — fenrir_backup.py (tar.gz + Google Drive).
# FunPay v2.2 шаг 1+2 — fenrir_funpay.py (чтение + классификация + очередь +
#   выполнение простых заказов; отправки в браузер НЕТ — её делает вотч).
# Утилиты (ram_guard, lix_countdown, health_summary, doctor, limits, usage) — fenrir_term.py.
# Агент с циклом инструментов — fenrir_agent.py.
set -u

# run_py <модуль> [аргументы...] — запуск модуля терминала с понятной
# ошибкой вместо сырого трейсбека (самопатч v3.0 P-003: кандидат 1 —
# обработка ошибок при загрузке модулей).
#   - файла нет → «модуль не найден» + путь, код выхода 1;
#   - ModuleNotFoundError/SyntaxError → короткая подсказка, тот же код выхода;
#   - иначе поведение как у прямого вызова python3, код выхода сохраняется.
run_py() {
  local mod="$1"; shift
  local path="$mod"
  case "$mod" in
    /*) : ;;
    *) path="$TERM_DIR/$mod" ;;
  esac
  if [ ! -f "$path" ]; then
    echo "fenrir: модуль $mod не найден ($path)" >&2
    echo "fenrir: проверьте установку терминала" >&2
    return 1
  fi
  local err rc
  err="$(mktemp)"
  python3 "$path" "$@" 2>"$err"
  rc=$?
  cat "$err" >&2
  if [ $rc -ne 0 ]; then
    if grep -q "ModuleNotFoundError" "$err"; then
      echo "fenrir: модуль $mod не загрузился — не найден импорт; проверьте файл $path" >&2
    elif grep -q "SyntaxError" "$err"; then
      echo "fenrir: в модуле $mod ошибка синтаксиса; проверьте файл $path (python3 -m py_compile $path)" >&2
    fi
  fi
  rm -f "$err"
  return $rc
}
ORCH="$HOME/workspace/fenrir-orchestra"
TERM_DIR="$(cd "$(dirname "$0")/.." && pwd)"
case "${1:-status}" in
  status)
    echo "🐺 Фенрир Терминал v1.3.1 — status"
    echo "---"
    run_py fenrir_term.py ram
    run_py fenrir_term.py lix
    echo "--- orchestra ---"
    curl -s -m 3 http://127.0.0.1:4097/health 2>/dev/null || echo "serve не отвечает (запуск: fenrir up)"
    echo "--- health (probe) ---"
    run_py fenrir_term.py health
    ;;
  ram)
    run_py fenrir_term.py ram
    free -h
    echo "--- топ по RAM ---"
    ps aux --sort=-%mem | head -n 6
    ;;
  health)
    run_py fenrir_term.py health
    ;;
  watchdog)
    bash "$TERM_DIR/bin/ram-watchdog.sh" && echo "watchdog ok (порог 300 МБ, лог: logs/ram-warnings.log)"
    ;;
  orchestra|orch)
    run_py "$ORCH/fenrir_orchestra.py" status
    ;;
  probe)
    run_py "$ORCH/fenrir_orchestra.py" probe
    ;;
  up)
    bash "$ORCH/watchdog.sh"
    sleep 2
    curl -s http://127.0.0.1:4097/health; echo
    ;;
  doctor)
    run_py fenrir_term.py doctor
    ;;
  limits)
    run_py fenrir_term.py limits
    ;;
  usage)
    run_py fenrir_term.py usage
    ;;
  agent)
    shift
    run_py fenrir_agent.py "$@"
    ;;
  task)
    shift
    run_py fenrir_scheduler.py task "$@"
    ;;
  scheduler)
    shift
    run_py fenrir_scheduler.py run "$@"
    ;;
  morning)
    shift
    run_py fenrir_digest.py "$@"
    ;;
  backup)
    shift
    run_py fenrir_backup.py "$@"
    ;;
  funpay)
    shift
    run_py fenrir_funpay.py "$@"
    ;;
  router)
    shift
    run_py "$ORCH/fenrir_router.py" "$@"
    ;;
  council)
    shift
    run_py fenrir_council.py "$@"
    ;;
  remote)
    shift
    run_py fenrir_remote.py "$@"
    ;;
  content)
    shift
    run_py fenrir_content.py "$@"
    ;;
  selfpatch)
    shift
    run_py fenrir_selfpatch.py "$@"
    ;;
  project)
    shift
    run_py fenrir_project.py "$@"
    ;;
  update)
    shift
    run_py fenrir_update.py "$@"
    ;;
  down)
    pkill -f "fenrir_orchestra.py serv[e]" && echo "fenrir-orchestra остановлена" || echo "serve не работала"
    ;;
  *)
    echo "fenrir: status | ram | health | watchdog | orchestra | probe | up | down | doctor | limits | usage | agent | task | scheduler | morning | backup | council | router | content | remote | selfpatch | project | update"
    ;;
esac
