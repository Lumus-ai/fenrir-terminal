#!/bin/bash
# Fenrir Terminal v1.3 — команда-идентификатор: кто я, что живо, сколько памяти.
# Использование: fenrir | fenrir status | fenrir ram | fenrir orchestra
#   fenrir probe | fenrir health | fenrir watchdog | fenrir up | fenrir down
#   fenrir doctor | fenrir limits | fenrir usage
#   fenrir agent --task "..." --workdir <папка> [--kind code|text]
#   fenrir agent --file tasks.jsonl
# Утилиты (ram_guard, lix_countdown, health_summary, doctor, limits, usage) — fenrir_term.py.
# Агент с циклом инструментов — fenrir_agent.py.
set -u
ORCH="$HOME/workspace/fenrir-orchestra"
TERM_DIR="$(cd "$(dirname "$0")/.." && pwd)"
case "${1:-status}" in
  status)
    echo "🐺 Фенрир Терминал v1.3 — status"
    echo "---"
    python3 "$TERM_DIR/fenrir_term.py" ram
    python3 "$TERM_DIR/fenrir_term.py" lix
    echo "--- orchestra ---"
    curl -s -m 3 http://127.0.0.1:4097/health 2>/dev/null || echo "serve не отвечает (запуск: fenrir up)"
    echo "--- health (probe) ---"
    python3 "$TERM_DIR/fenrir_term.py" health
    ;;
  ram)
    python3 "$TERM_DIR/fenrir_term.py" ram
    free -h
    echo "--- топ по RAM ---"
    ps aux --sort=-%mem | head -n 6
    ;;
  health)
    python3 "$TERM_DIR/fenrir_term.py" health
    ;;
  watchdog)
    bash "$TERM_DIR/bin/ram-watchdog.sh" && echo "watchdog ok (порог 300 МБ, лог: logs/ram-warnings.log)"
    ;;
  orchestra|orch)
    python3 "$ORCH/fenrir_orchestra.py" status
    ;;
  probe)
    python3 "$ORCH/fenrir_orchestra.py" probe
    ;;
  up)
    bash "$ORCH/watchdog.sh"
    sleep 2
    curl -s http://127.0.0.1:4097/health; echo
    ;;
  doctor)
    python3 "$TERM_DIR/fenrir_term.py" doctor
    ;;
  limits)
    python3 "$TERM_DIR/fenrir_term.py" limits
    ;;
  usage)
    python3 "$TERM_DIR/fenrir_term.py" usage
    ;;
  agent)
    shift
    python3 "$TERM_DIR/fenrir_agent.py" "$@"
    ;;
  down)
    pkill -f "fenrir_orchestra.py serv[e]" && echo "fenrir-orchestra остановлена" || echo "serve не работала"
    ;;
  *)
    echo "fenrir: status | ram | health | watchdog | orchestra | probe | up | down | doctor | limits | usage | agent"
    ;;
esac
